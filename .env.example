# ─── Server ───────────────────────────────────────────────────────────────────

# Server port (default: 8787)
PORT=8787

# Database URL.
# Local SQLite (default – only suitable for single-instance deployments):
#   DATABASE_URL=file:./prisma/dev.db
# Turso (recommended for production):
#   DATABASE_URL=libsql://[db-name]-[org].turso.io?authToken=YOUR_TOKEN
DATABASE_URL=file:./prisma/dev.db

# External URL for the BIIP boundary/address API (default shown below)
BIIP_BASE_URL=https://boundaries.biip.lt

# Set to "true" to disable PDF generation (removes Puppeteer/Chromium requirement)
DISABLE_PDF=false

# ─── Docker Compose ───────────────────────────────────────────────────────────

# Host port the web container will listen on (default: 80)
WEB_PORT=80
