datasource db {
    provider = "sqlite"
}

generator client {
    provider = "prisma-client-js"
}

model ParcelReport {
    id             String   @id @default(uuid())
    address        String
    cadastralRegNo String   @unique
    coordinates    String
    reportData     String
    pdfCachedPath  String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([cadastralRegNo])
    @@index([address])
}
