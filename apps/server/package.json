{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "puppeteer browsers install chrome",
    "check-env": "bun run ./src/env.ts",
    "dev": "bun run check-env && bun --watch src/index.ts",
    "build": "bun run check-env && bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run check-env && bun run ./dist/index.js",
    "prisma": "prisma",
    "clear-parcel-report-cache": "bun run ./src/scripts/clear-parcel-report-cache.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@orpc/client": "latest",
    "@orpc/server": "latest",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "@zeme/shared": "workspace:*",
    "hono": "latest",
    "puppeteer": "latest",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.7.0",
    "zod": "latest"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "latest",
    "@types/bun": "latest"
  }
}
